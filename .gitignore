# ————————— 本项目补充规则（非源码 / 可再生成产物 / 本地状态）—————————

# 平台构建中间产物（体积很大且可再生成）
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
android/.gradle/
android/.kotlin/
android/app/.cxx/
android/**/build/
# 本机路径（flutter.sdk / sdk.dir），不应提交
android/local.properties

# 本地 AI/编辑器工作状态（个人配置，不入库）
.codebuddy/
.vscode/

